# Values Dating App – required environment variables
# Copy to .env and fill in values. For EAS builds, set these in EAS Secrets (Dashboard or CLI).
# See: https://docs.expo.dev/build-reference/variables/

# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (required for Google sign-in)
# Use Web Client ID from https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: backend API base URL (defaults to https://api.example.com if unset)
# EXPO_PUBLIC_API_URL=https://api.example.com
