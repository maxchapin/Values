{
  "expo": {
    "name": "The Local",
    "slug": "values-dating",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "values",
    "imageMaxAge": 60,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "We use your photos only so you can choose profile pictures to show to potential matches."
        }
      ],
      [
        "expo-apple-authentication",
        {
          "appleAuthentication": {
            "enabled": true
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-mail-composer",
      [
        "expo-camera",
        {
          "cameraPermission": "We use your camera to scan venue QR codes for check-in.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Local uses your location at check-in to confirm you're at the venue."
        }
      ],
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "values-uv"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.values.app",
      "associatedDomains": ["applinks:thelocaldating.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.values.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thelocaldating.com",
              "pathPrefix": "/checkin"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googleClientId": "",
      "policyVersion": "1",
      "privacyPolicyUrl": "https://thelocaldating.com/privacy",
      "termsOfServiceUrl": "https://thelocaldating.com/terms",
      "supabaseRedirectTo": "${EXPO_PUBLIC_SUPABASE_URL}/auth/v1/callback",
      "eas": {
        "projectId": "5ba96ab4-b67a-4a67-be1c-547129534a1d"
      }
    }
  }
}
